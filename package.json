{
  "name": "noctisai",
  "version": "1.0.3",
  "description": "Noctisai - Private AI Chat - Secure Electron app with screen-sharing protection",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "build": "electron-builder --win",
    "build:publish": "electron-builder --win --publish always",
    "test": "node --test",
    "rebuild": "cd native && node-gyp rebuild",
    "install": "cd native && node-gyp rebuild",
    "build:linux": "electron-builder --linux",
    "build:linux:publish": "docker run --rm -v \".:/project\" -v \"%USERPROFILE%/.cache/electron:/root/.cache/electron\" -v \"%USERPROFILE%/.cache/electron-builder:/root/.cache/electron-builder\" -e GH_TOKEN=%GH_TOKEN% electronuserland/builder:wine sh -c \"cd /project && npm run build:linux:ci\"",
    "build:linux:ci": "electron-builder --linux --publish always",
    "build:linux:docker": "docker run --rm -v \".:/project\" -v \"%USERPROFILE%/.cache/electron:/root/.cache/electron\" -v \"%USERPROFILE%/.cache/electron-builder:/root/.cache/electron-builder\" electronuserland/builder:wine npm run build:linux",
    "build:all": "npm run build && npm run build:linux:docker",
    "build:all:publish": "npm run build:publish && npm run build:linux:publish"
  },
  "build": {
    "appId": "app.noctisai.desktop",
    "productName": "Noctisai",
    "copyright": "Copyright © 2024 Noctisai",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!native/**/*",
      "!**/*.gyp",
      "!**/node_modules/.bin"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Noctisai"
    },
    "publish": {
      "provider": "github",
      "owner": "IsmailofficialGithub",
      "repo": "interview-cracker",
      "releaseType": "release"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  },
  "keywords": [
    "electron",
    "ai",
    "chat",
    "privacy",
    "encryption"
  ],
  "author": "Noctisai <info@noctisai.app>",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "node-gyp": "^9.0.0"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-updater": "^6.8.3",
    "form-data": "^4.0.0",
    "groq-sdk": "^0.5.0",
    "marked": "^11.1.1",
    "node-addon-api": "^7.0.0",
    "semver": "^7.7.4"
  }
}